{
  "manifest_version": 3,
  "name": "Orquestra Browser Bridge",
  "version": "0.1.0",
  "description": "Detecta apenas abas oficiais ChatGPT e Claude abertas no Chrome, sem acessar conversas ou cookies.",
  "permissions": [
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://orquestra-dev-app.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Orquestra Browser Bridge",
    "default_popup": "popup.html"
  }
}
